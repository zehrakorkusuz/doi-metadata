# OpenAIRE OAuth2 — get token at https://aai.openaire.eu
# Auth: Authorization: Bearer {OPENAIRE_API_KEY}
# Optional (unauthenticated works but rate-limited)
OPENAIRE_API_KEY=
OPENAIRE_REFRESH_TOKEN=

# OpenAlex — polite pool (DEPRECATED Feb 13, 2026, get key at https://openalex.org/settings/api)
OPENALEX_EMAIL=your@email.com
OPENALEX_API_KEY=

# CrossRef — polite pool (email recommended, no key needed)
CROSSREF_EMAIL=your@email.com

# DataCite — fully public API, no auth needed
DATACITE_PASSWORD=

# Unpaywall — email required in query param
UNPAYWALL_EMAIL=your@email.com

# Semantic Scholar — optional, get key at https://www.semanticscholar.org/product/api
# Auth: x-api-key header. Without key: shared pool. With key: dedicated 1 req/s.
SEMANTIC_SCHOLAR_API_KEY=

# ORCID — register at https://orcid.org/developer-tools for public API client_credentials
# Then: POST https://orcid.org/oauth/token with client_id, client_secret, grant_type=client_credentials, scope=/read-public
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# NIH Reporter — no key needed (POST API)
NIH_REPORTER_BASE_URL=https://api.reporter.nih.gov/v2

# Entrez/PubMed — NCBI E-utilities
# Register at https://www.ncbi.nlm.nih.gov/account/ for an API key
# Without key: 3 req/s. With key: 10 req/s.
ENTREZ_EMAIL=your@email.com
ENTREZ_API_KEY=

# VoyageAI (for ML embeddings)
VOYAGEAI_API_KEY=

# Google API
GOOGLE_API_KEY=

# Cache settings
CACHE_DIR=~/.cache/doi-metadata
CACHE_TTL_SECONDS=604800
